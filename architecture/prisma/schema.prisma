// Stage 2 draft, kept for reference. Since Stage 6 the live schema is apps/api/prisma/schema.prisma.
// Garment Studio: database schema (Stage 2 draft)
// See docs/DATA_MODEL.md and ADR-0008 … ADR-0014.
// Conventions: cuid2 ids generated by the app, timestamps in UTC, soft delete via deletedAt,
// every user-owned row carries ownerId/userId and every query is owner-scoped (ADR-0010).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ───────────────────────────── Identity ─────────────────────────────

enum Role {
  user
  admin
}

model User {
  id              String    @id
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime?
  passwordHash    String? // argon2id; null for magic-link/OAuth-only accounts
  displayName     String?
  role            Role      @default(user)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // soft delete; purge job runs after 30 days

  identities   AuthIdentity[]
  sessions     Session[]
  tokens       VerificationToken[]
  settings     UserSettings?
  projects     Project[]
  assets       Asset[]
  renderJobs   RenderJob[]
  exports      ExportRecord[]
  subscription Subscription?
  creditGrants CreditGrant[]
  usageEvents  UsageEvent[]
  auditLogs    AuditLog[]          @relation("AuditActor")

  @@index([deletedAt])
}

enum AuthProvider {
  google
  apple
}

model AuthIdentity {
  id          String       @id
  userId      String
  provider    AuthProvider
  providerUid String
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
}

enum ClientPlatform {
  web
  pwa
  desktop
}

/// One row per refresh-token family. The token itself is never stored, only its SHA-256.
model Session {
  id          String         @id
  userId      String
  familyId    String // rotation family; reuse of a rotated token revokes the family
  refreshHash String         @unique
  platform    ClientPlatform
  deviceName  String?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime       @default(now())
  lastUsedAt  DateTime       @default(now())
  expiresAt   DateTime
  rotatedAt   DateTime?
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

enum TokenPurpose {
  email_verify
  magic_link
  password_reset
  desktop_pkce // authorization code for the desktop PKCE exchange
}

model VerificationToken {
  id            String       @id
  userId        String?
  email         String       @db.Citext
  purpose       TokenPurpose
  tokenHash     String       @unique
  codeChallenge String? // PKCE S256 challenge (desktop_pkce only)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([expiresAt])
}

model UserSettings {
  userId       String   @id
  theme        String   @default("dark") // dark | light | system
  unit         String   @default("cm") // mm | cm | in
  locale       String   @default("en")
  lookDefaults Json? // saved "Default settings" (fabric/scene/light)
  hints        Json? // dismissed hints and tour state
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Projects ─────────────────────────────

model Project {
  id             String    @id
  ownerId        String
  name           String    @db.VarChar(120)
  garmentModelId String
  garmentVersion String
  headRevision   Int       @default(0)
  thumbAssetId   String?
  duplicatedFrom String?
  conflictOf     String? // set on "(conflicted copy)" projects
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  garment    GarmentModel     @relation(fields: [garmentModelId, garmentVersion], references: [id, version])
  thumb      Asset?           @relation("ProjectThumb", fields: [thumbAssetId], references: [id], onDelete: SetNull)
  versions   ProjectVersion[]
  assets     ProjectAsset[]
  renderJobs RenderJob[]
  exports    ExportRecord[]

  @@index([ownerId, deletedAt, updatedAt(sort: Desc)])
}

/// Append-only. `doc` is a full ProjectDoc snapshot validated by packages/core zod schemas.
model ProjectVersion {
  id            String         @id
  projectId     String
  revision      Int
  baseRevision  Int? // revision the client edited from (null for revision 1)
  schemaVersion Int
  doc           Json
  docSha256     String
  docBytes      Int
  platform      ClientPlatform
  deviceId      String?
  createdAt     DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, revision])
  @@index([projectId, createdAt(sort: Desc)])
}

// ───────────────────────────── Assets ─────────────────────────────

enum AssetKind {
  artwork
  thumbnail
  render
  export
}

enum ScanStatus {
  pending
  clean
  rejected
}

model Asset {
  id         String     @id
  ownerId    String
  kind       AssetKind
  sha256     String
  mime       String
  bytes      BigInt
  width      Int?
  height     Int?
  isVector   Boolean    @default(false)
  storageKey String     @unique
  scanStatus ScanStatus @default(pending)
  scanNote   String?
  uploadId   String? // multipart upload id while incomplete
  completed  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  lastRefAt  DateTime   @default(now()) // GC: unreferenced for 30 days → delete

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects      ProjectAsset[]
  thumbOf       Project[]      @relation("ProjectThumb")
  renderOutputs RenderJob[]    @relation("RenderOutput")
  exportOutputs ExportRecord[] @relation("ExportOutput")

  @@unique([ownerId, sha256, kind])
  @@index([ownerId, kind])
  @@index([lastRefAt])
}

model ProjectAsset {
  projectId String
  assetId   String
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([projectId, assetId])
  @@index([assetId])
}

// ───────────────────────────── Garments ─────────────────────────────

/// Immutable per version. `manifest` is the GarmentModel JSON produced by garment-tools (ADR-0007).
model GarmentModel {
  id          String
  version     String
  category    String
  tier        String // plan id required to use it (ADR-0012)
  manifest    Json
  sortOrder   Int       @default(0)
  publishedAt DateTime?
  retiredAt   DateTime?
  createdAt   DateTime  @default(now())

  projects Project[]

  @@id([id, version])
  @@index([publishedAt])
}

// ───────────────────────────── Rendering & export ─────────────────────────────

enum JobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum RenderTarget {
  cloud
  local // recorded for quota/analytics; executed on the client
}

model RenderJob {
  id              String       @id
  userId          String
  projectId       String
  revision        Int
  target          RenderTarget @default(cloud)
  params          Json // { width, height, frame, quality, samples, transparent, camera, format[] }
  status          JobStatus    @default(queued)
  progress        Float        @default(0) // 0..1
  samplesDone     Int          @default(0)
  attempts        Int          @default(0)
  workerId        String?
  errorCode       String?
  errorMessage    String?
  outputAssetId   String?
  gpuSeconds      Float?
  idempotencyKey  String?
  cancelRequested Boolean      @default(false)
  createdAt       DateTime     @default(now())
  startedAt       DateTime?
  heartbeatAt     DateTime?
  finishedAt      DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  output  Asset?  @relation("RenderOutput", fields: [outputAssetId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

enum ExportKind {
  snapshot
  print_zip
  sublimation_zip
  spec_pdf
  turntable_video
}

model ExportRecord {
  id            String     @id
  userId        String
  projectId     String
  revision      Int
  kind          ExportKind
  params        Json
  ranOn         String // "client" | "server"
  status        JobStatus  @default(succeeded)
  outputAssetId String? // only for server-side exports
  createdAt     DateTime   @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  output  Asset?  @relation("ExportOutput", fields: [outputAssetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
}

// ───────────────────────────── Entitlements & billing (ADR-0012) ─────────────────────────────

/// Plans are data. `limits` keys: projects, images, exportsPerMonth, cloudRendersPerMonth,
/// renderMaxPx, renderQualities[], localRender, storageBytes, watermark, garmentTiers[]. null = unlimited.
model Plan {
  id          String   @id // e.g. "free", "dev"
  name        String
  limits      Json
  isDefault   Boolean  @default(false)
  isPublic    Boolean  @default(false)
  providerRef Json? // provider price ids by period, filled when billing is enabled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  cancelled
  expired
}

model Subscription {
  id                 String             @id
  userId             String             @unique
  planId             String
  status             SubscriptionStatus
  provider           String // "manual" | "paddle" | "stripe"
  providerCustomerId String?
  providerSubId      String?            @unique
  period             String? // monthly | yearly
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  graceUntil         DateTime? // storage grace after downgrade
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
}

model CreditGrant {
  id        String    @id
  userId    String
  kind      String // "render" | "export"
  amount    Int
  remaining Int
  source    String // "pack:renders10" | "admin" | "promo"
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, expiresAt])
}

/// Append-only usage ledger. `key` makes charges idempotent (e.g. "render:{jobId}").
model UsageEvent {
  id            String   @id
  userId        String
  action        String // export.create | render.cloud | asset.upload | ...
  quantity      Int      @default(1)
  creditGrantId String?
  key           String   @unique
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action, createdAt])
}

model BillingWebhookEvent {
  id          String    @id // provider event id → dedupe
  provider    String
  type        String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id        String   @id
  actorId   String?
  action    String // auth.login, auth.reset, project.delete, account.delete, admin.plan.assign …
  target    String?
  ipHash    String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}
