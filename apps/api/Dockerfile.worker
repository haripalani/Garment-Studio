# Render worker image: the API bundle + the built editor (render.html) + Playwright's Chromium.
# GPU nodes pass the backend flags via RENDER_CHROMIUM_ARGS (ADR-0020). Build from the repository root:
#   docker build -f apps/api/Dockerfile.worker -t garment-studio/render-worker .
FROM node:22.23.0-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile --filter @gs/api... --filter @gs/editor... \
 && pnpm --filter @gs/editor build \
 && pnpm --filter @gs/api build \
 && pnpm --filter @gs/api deploy --legacy --prod /out \
 && cp -r apps/api/dist /out/dist \
 && cp -r apps/editor/dist /out/editor-dist \
 && cd /out && npx prisma generate

FROM mcr.microsoft.com/playwright:v1.64.1-noble AS worker
WORKDIR /app
COPY --from=build /out ./
ENV NODE_ENV=production RENDER_PAGE_DIR=/app/editor-dist RENDER_PROFILE_DIR=/data/chromium-profile
VOLUME /data
CMD ["node", "dist/render-worker.js"]
