# apps/api configuration. Copy to .env; `pnpm --filter @gs/api keys` prints a fresh signing key.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://gs:gs-dev-password@127.0.0.1:55432/gs
REDIS_URL=redis://127.0.0.1:56379/0
# Origins allowed to call the API with credentials (comma-separated)
CORS_ORIGINS=http://localhost:5173
# Where emailed links point (the editor)
APP_URL=http://localhost:5173
# Ed25519 private key as a JWK (JSON on one line). Signs access tokens and entitlement snapshots.
JWT_PRIVATE_JWK=
# Secret for hashing IP addresses in audit logs and sessions (any long random string)
IP_HASH_SECRET=
COOKIE_SECURE=true
# S3-compatible storage (SeaweedFS locally, Cloudflare R2 in staging/production)
S3_ENDPOINT=http://127.0.0.1:58333
S3_REGION=us-east-1
S3_BUCKET=gs-dev
# Public-read bucket for immutable garment files (R2: a bucket with public access / custom domain)
S3_PUBLIC_BUCKET=gs-dev-public
S3_ACCESS_KEY=gs-dev-access
S3_SECRET_KEY=gs-dev-secret-key
S3_FORCE_PATH_STYLE=true
# Public base URL of S3_PUBLIC_BUCKET (a CDN domain in production)
PUBLIC_ASSET_BASE=http://127.0.0.1:58333/gs-dev-public
SMTP_URL=smtp://127.0.0.1:51025
MAIL_FROM=Garment Studio <no-reply@garmentstudio.example>
# clamav | off  (off is refused when NODE_ENV=production)
ANTIVIRUS=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=53310
# Check new passwords against Have I Been Pwned (k-anonymity range API; only a 5-char hash prefix leaves the server)
PASSWORD_BREACH_CHECK=false
# Plan given to users without a subscription (ADR-0012): dev (no limits) or free
DEFAULT_PLAN=dev
# Run the asset-scan and purge workers in this process (true for a single-process deployment)
RUN_WORKERS=true
TRUST_PROXY=false
